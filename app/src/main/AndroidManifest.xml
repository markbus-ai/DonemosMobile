<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        configChanges: screens are built in code and keep no saved instance
        state, so recreating them on rotation, resize or keyboard changes would
        wipe half-filled forms and drop in-flight results; they handle those
        changes in place. density is NOT listed: every size is converted from
        dp when the views are built, so a display-size change needs the
        recreate the system does by default to get correct dimensions.
    -->
    <application
        android:name=".DonemosApp"
        android:allowBackup="true"
        android:label="DonemosMobile"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
        tools:targetApi="34">
        <activity
            android:name=".DonemosMobileActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.auth.LoginActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
            android:exported="false" />
        <activity
            android:name=".ui.pacientes.PacientesActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard" />
        <activity
            android:name=".ui.pacientes.PacienteLookupActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard" />
        <activity
            android:name=".ui.turnos.TurnosActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard" />
        <activity
            android:name=".ui.donaciones.DonacionesActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard" />
        <activity
            android:name=".ui.aptitud.AptitudActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard" />
        <activity
            android:name=".ui.mas.MasActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard" />
    </application>
</manifest>
